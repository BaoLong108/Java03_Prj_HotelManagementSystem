POSTGRES_DB=hotel_pms
POSTGRES_USER=hotel_pms
POSTGRES_PASSWORD=hotel_pms_dev
# Compose demo only. A fresh volume uses this password; existing accounts are never overwritten.
DEMO_SEED_ENABLED=true
DEMO_SEED_PASSWORD=HotelPmsDemo123!
JWT_SECRET=hotel-pms-compose-demo-only-signing-key-change-before-deployment
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=5173
# Optional sandbox integrations. Supply credentials in your local .env.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/payment-return
CONFIRMATION_MAIL_ENABLED=false
CONFIRMATION_MAIL_FROM=hotel-pms@example.test
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
